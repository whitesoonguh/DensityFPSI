{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release: AVX-512 + VAES + VPCLMUL (paper reference profile)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FPSI_ENABLE_NATIVE": "ON",
        "FPSI_ENABLE_AVX512": "ON"
      }
    },
    {
      "name": "release-no-avx512",
      "displayName": "Release: no AVX-512 (VAES/VPCLMUL + AVX2 via -march=native; e.g. AMD Zen3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-no-avx512",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FPSI_ENABLE_NATIVE": "ON",
        "FPSI_ENABLE_AVX512": "OFF",
        "FPSI_REQUIRE_AVX512_VAES_VPCLMUL": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "release-no-avx512", "configurePreset": "release-no-avx512" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "release-no-avx512", "configurePreset": "release-no-avx512", "output": { "outputOnFailure": true } }
  ]
}